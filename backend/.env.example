# Required for Submittal Evaluation (Technical Submittal Auditor).
# Get an API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Production: comma-separated frontend URLs for CORS (e.g. https://your-app.vercel.app, https://your-username.github.io)
# CORS_ORIGINS=https://your-app.vercel.app

# Optional: model used for submittal audit (default: gemini-2.5-flash)
# GEMINI_AUDIT_MODEL=gemini-2.5-flash
# For stronger reasoning: GEMINI_AUDIT_MODEL=gemini-2.5-pro

# Pipeline extraction: use "gemini" (default) or "openai"
# EXTRACTION_LLM=gemini
# Gemini model for extraction (default: gemini-1.5-pro)
# GEMINI_EXTRACTION_MODEL=gemini-1.5-pro
# OpenAI (when EXTRACTION_LLM=openai): https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# OPENAI_EXTRACTION_MODEL=gpt-4o
